msgstr "NVMe Monitor"

#: prefs.js:19
msgid "General"
msgstr "Allgemein"

#: prefs.js:25
msgid "Temperature"
msgstr "Temperatur"

#: prefs.js:26
msgid "Unit used to display drive temperatures"
msgstr "Einheit zur Anzeige der Laufwerkstemperaturen"

#: prefs.js:65
msgid "Credits"
msgstr "Credits"

#: prefs.js:70
msgid "Assisted by"
msgstr "Unterstützt von"

#: indicator.js:132
msgid "Enable NVMe smart-log access"
msgstr "NVMe smart-log-Zugriff aktivieren"

#: indicator.js:163
msgid "Preferences"
msgstr "Einstellungen"

#: indicator.js:335
msgid "nvme-cli not installed"
msgstr "nvme-cli ist nicht installiert"

#: indicator.js:341
msgid "No NVMe devices found"
msgstr "Keine NVMe-Geräte gefunden"

#: indicator.js:414 indicator.js:417
msgid "Available Spare"
msgstr "Verfügbare Reserve"

msgid ""
"Reserved capacity the drive can swap in to replace failing blocks. Critical "
"below 15%, warning below 50%, OK otherwise."
msgstr ""
"Reservekapazität, die das Laufwerk zum Ersetzen fehlerhafter Blöcke einsetzen "
"kann. Kritisch unter 15 %, Warnung unter 50 %, sonst OK."

#: indicator.js:425 indicator.js:428
msgid "Lifetime Used"
msgstr "Verbrauchte Lebensdauer"

msgid ""
"Estimated portion of the drive endurance consumed. OK below 50%, warning up "
"to 85%, critical above."
msgstr ""
"Geschätzter Anteil der verbrauchten Laufwerkshaltbarkeit. OK unter 50 %, "
"Warnung bis 85 %, kritisch darüber."

#: indicator.js:445
msgid "  SMART: parse error"
msgstr "  SMART: Auswertungsfehler"

#: indicator.js:451
msgid "  SMART: unavailable"
msgstr "  SMART: nicht verfügbar"

#: indicator.js:449
msgid "  SMART: log out and back in to enable access"
msgstr "  SMART: zum Aktivieren ab- und wieder anmelden"

#: indicator.js:458
msgid "  Stale data"
msgstr "  Veraltete Daten"

#: indicator.js:454
msgid "  Install NVMe Stack for SMART data"
msgstr "  NVMe-Stack für SMART-Daten installieren"

