#: extension.js:145
msgid "nvme-cli compatibility warning"
msgstr "nvme-cli Kompatibilitäts-Warnung"

#: extension.js:146 extension.js:203
msgid "NVMe Monitor"
msgstr "NVMe Monitor"

#: extension.js:233
msgid "Service Setup"
msgstr "Diensteinrichtung"

#: extension.js:369
msgid "nvme-cli not installed"
msgstr "nvme-cli ist nicht installiert"

#: extension.js:374
msgid "No NVMe devices found"
msgstr "Keine NVMe-Geräte gefunden"

#: extension.js:415 extension.js:418
msgid "Available Spare"
msgstr "Verfügbare Reserve"

#: extension.js:419
msgid ""
"Reserved capacity the drive can swap in to replace failing blocks. Red below "
"15%, orange below 50%, green otherwise."
msgstr ""
"Reservekapazität, die das Laufwerk zum Ersetzen fehlerhafter Blöcke einsetzen "
"kann. Rot unter 15 %, orange unter 50 %, sonst grün."

#: extension.js:426 extension.js:429
msgid "Percentage Used"
msgstr "Prozentanteil verbraucht"

#: extension.js:430
msgid ""
"Estimated portion of the drive endurance consumed. Green below 50%, orange "
"up to 85%, red above (inverted logic)."
msgstr ""
"Geschätzter Anteil der verbrauchten Laufwerkshaltbarkeit. Grün unter 50 %, "
"orange bis 85 %, rot darüber (umgekehrte Logik)."

#: extension.js:443
msgid "  SMART: parse error"
msgstr "  SMART: Auswertungsfehler"

#: extension.js:447
msgid "  SMART: unavailable"
msgstr "  SMART: nicht verfügbar"

#: extension.js:450
msgid "  Install NVMe Stack for SMART data"
msgstr "  NVMe-Stack für SMART-Daten installieren"

