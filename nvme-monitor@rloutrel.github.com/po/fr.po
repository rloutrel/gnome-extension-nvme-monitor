#: extension.js:145
msgid "nvme-cli compatibility warning"
msgstr "Avertissement de compatibilité nvme-cli"

#: extension.js:146 extension.js:203
msgid "NVMe Monitor"
msgstr "NVMe Monitor"

#: extension.js:233
msgid "Service Setup"
msgstr "Configuration du service"

#: extension.js:369
msgid "nvme-cli not installed"
msgstr "nvme-cli n'est pas installé"

#: extension.js:374
msgid "No NVMe devices found"
msgstr "Aucun périphérique NVMe détecté"

#: extension.js:415 extension.js:418
msgid "Available Spare"
msgstr "Spare disponible"

#: extension.js:419
msgid ""
"Reserved capacity the drive can swap in to replace failing blocks. Red below "
"15%, orange below 50%, green otherwise."
msgstr ""
"Capacité de réserve que le disque peut mobiliser pour remplacer les blocs "
"défaillants. Rouge sous 15 %, orange sous 50 %, vert sinon."

#: extension.js:426 extension.js:429
msgid "Percentage Used"
msgstr "Pourcentage utilisé"

#: extension.js:430
msgid ""
"Estimated portion of the drive endurance consumed. Green below 50%, orange "
"up to 85%, red above (inverted logic)."
msgstr ""
"Part estimée de l'endurance du disque consommée. Vert sous 50 %, orange "
"jusqu'à 85 %, rouge au-delà (logique inversée)."

#: extension.js:443
msgid "  SMART: parse error"
msgstr "  SMART : erreur d'analyse"

#: extension.js:447
msgid "  SMART: unavailable"
msgstr "  SMART : indisponible"

#: extension.js:450
msgid "  Install NVMe Stack for SMART data"
msgstr "  Installer la pile NVMe pour les données SMART"

