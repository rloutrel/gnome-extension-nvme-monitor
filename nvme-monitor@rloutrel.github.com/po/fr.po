#: subprocess.js:143
msgid "nvme-cli compatibility warning"
msgstr "Avertissement de compatibilité nvme-cli"

#: indicator.js:87 subprocess.js:144
msgid "NVMe Monitor"
msgstr "NVMe Monitor"

#: prefs.js:19
msgid "General"
msgstr "Général"

#: prefs.js:25
msgid "Temperature"
msgstr "Température"

#: prefs.js:26
msgid "Unit used to display drive temperatures"
msgstr "Unité utilisée pour afficher les températures des disques"

#: prefs.js:65
msgid "Credits"
msgstr "Crédits"

#: prefs.js:70
msgid "Assisted by"
msgstr "Assisté par"

#: indicator.js:132
msgid "Enable NVMe smart-log access"
msgstr "Activer l'accès aux smart-logs NVMe"

#: indicator.js:163
msgid "Preferences"
msgstr "Préférences"

#: indicator.js:335
msgid "nvme-cli not installed"
msgstr "nvme-cli n'est pas installé"

#: indicator.js:341
msgid "No NVMe devices found"
msgstr "Aucun périphérique NVMe détecté"

#: indicator.js:414 indicator.js:417
msgid "Available Spare"
msgstr "Spare disponible"

msgid ""
"Reserved capacity the drive can swap in to replace failing blocks. Critical "
"below 15%, warning below 50%, OK otherwise."
msgstr ""
"Capacité de réserve que le disque peut mobiliser pour remplacer les blocs "
"défaillants. Critique sous 15 %, avertissement sous 50 %, OK sinon."

#: indicator.js:425 indicator.js:428
msgid "Lifetime Used"
msgstr "Durée de vie utilisée"

msgid ""
"Estimated portion of the drive endurance consumed. OK below 50%, warning up "
"to 85%, critical above."
msgstr ""
"Part estimée de l'endurance du disque consommée. OK sous 50 %, avertissement "
"jusqu'à 85 %, critique au-delà."

#: indicator.js:445
msgid "  SMART: parse error"
msgstr "  SMART : erreur d'analyse"

#: indicator.js:451
msgid "  SMART: unavailable"
msgstr "  SMART : indisponible"

#: indicator.js:449
msgid "  SMART: log out and back in to enable access"
msgstr "  SMART : déconnectez-vous puis reconnectez-vous pour activer l'accès"

#: indicator.js:458
msgid "  Stale data"
msgstr "  Données obsolètes"

#: indicator.js:454
msgid "  Install NVMe Stack for SMART data"
msgstr "  Installer la pile NVMe pour les données SMART"

#: indicator.js:1342
msgid "Controller"
msgstr "Contrôleur"

#: indicator.js:1343
msgid "NAND"
msgstr "NAND"

#: indicator.js:1344
msgid "Sensor"
msgstr "Capteur"

#: indicator.js:1370
msgid "Power Cycles"
msgstr "Cycles d'alimentation"

#: indicator.js:1374
msgid "Power On"
msgstr "Mise sous tension"

#: indicator.js:1378
msgid "Unsafe Shutdowns"
msgstr "Arrêts non sécurisés"

#: indicator.js:1395
msgid "Data Read"
msgstr "Données lues"

#: indicator.js:1402
